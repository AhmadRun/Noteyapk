<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The PIN store is encrypted with a Keystore key that never leaves the device.
         Restoring it elsewhere makes it undecryptable and crashes the app on launch. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="notey_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="notey_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
